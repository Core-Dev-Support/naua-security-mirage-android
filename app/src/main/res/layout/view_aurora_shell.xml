<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora shell: slow amber blobs + liquid glass. Home screen in XML; settings/FAQ/version and sheets are built in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/auRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/au_bg">

    <!-- aurora blobs -->
    <FrameLayout
        android:id="@+id/auAurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/auBlob1"
            android:layout_width="430dp"
            android:layout_height="430dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="-170dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_au_blob1" />

        <View
            android:id="@+id/auBlob2"
            android:layout_width="380dp"
            android:layout_height="380dp"
            android:layout_gravity="end|top"
            android:layout_marginEnd="-170dp"
            android:layout_marginTop="360dp"
            android:background="@drawable/bg_au_blob2" />

        <View
            android:id="@+id/auBlob3"
            android:layout_width="400dp"
            android:layout_height="400dp"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="-40dp"
            android:layout_marginBottom="-190dp"
            android:background="@drawable/bg_au_blob3" />
    </FrameLayout>

    <!-- screens -->
    <FrameLayout
        android:id="@+id/auScreens"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/auHomeScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingBottom="132dp"
            android:paddingEnd="16dp"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/auHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:gravity="start"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/auTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/unbounded_600"
                            android:letterSpacing="-0.015"
                            android:text="@string/brand_name"
                            android:textColor="@color/au_fg"
                            android:textSize="28sp" />

                        <TextView
                            android:id="@+id/auEyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:letterSpacing="0.02"
                            android:text="@string/brand_sub"
                            android:textColor="@color/au_fg_2"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/auLangBtn"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_au_glass_circle"
                        android:contentDescription="@string/au_lang_btn_desc"
                        android:fontFamily="@font/onest_600"
                        android:gravity="center"
                        android:text="RU"
                        android:textColor="@color/au_fg"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <ImageView
                        android:id="@+id/auRefreshBtn"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_au_glass_circle"
                        android:contentDescription="@string/au_refresh_desc"
                        android:padding="11dp"
                        android:src="@drawable/ic_refresh"
                        android:tint="@color/au_fg_2"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- orb -->
                <FrameLayout
                    android:id="@+id/auOrbWrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:paddingTop="20dp">

                    <FrameLayout
                        android:id="@+id/auOrb"
                        android:layout_width="216dp"
                        android:layout_height="216dp"
                        android:layout_gravity="center_horizontal"
                        android:contentDescription="@string/au_orb_desc"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/auHalo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="-50dp"
                            android:alpha="0"
                            android:background="@drawable/bg_au_halo" />

                        <View
                            android:id="@+id/auPulse1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:alpha="0"
                            android:background="@drawable/bg_au_pulse" />

                        <View
                            android:id="@+id/auPulse2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:alpha="0"
                            android:background="@drawable/bg_au_pulse" />

                        <View
                            android:id="@+id/auOrbRing"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_au_glass_circle" />

                        <com.naua_security_mirage.app.ui.view.AuroraArcView
                            android:id="@+id/auArc"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:alpha="0" />

                        <View
                            android:id="@+id/auCoreOn"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="26dp"
                            android:alpha="0"
                            android:background="@drawable/bg_au_core_on" />

                        <View
                            android:id="@+id/auCoreOff"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="26dp"
                            android:alpha="0"
                            android:background="@drawable/bg_au_core_off" />

                        <ImageView
                            android:id="@+id/auOrbIcon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_power"
                            android:tint="@color/au_fg_2" />
                    </FrameLayout>
                </FrameLayout>

                <!-- status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="6dp">

                    <TextView
                        android:id="@+id/auStatusLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/unbounded_600"
                        android:text="@string/status_disconnected"
                        android:textColor="@color/au_fg"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/auStatusMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono_500"
                        android:layout_marginTop="6dp"
                        android:text="@string/au_status_meta_tap"
                        android:textColor="@color/au_fg_2"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/auStatusMetaRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/auSessionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jetbrains_mono_500"
                            android:text="00:00"
                            android:textColor="@color/au_fg_2"
                            android:textSize="14sp" />

                        <View
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:alpha="0.6"
                            android:background="@drawable/bg_au_dot" />

                        <TextView
                            android:id="@+id/auPingText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jetbrains_mono_500"
                            android:text="@string/glass_ping_placeholder"
                            android:textColor="@color/au_fg_2"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- server switch -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp">

                    <FrameLayout
                        android:id="@+id/auSeg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_au_glass_seg"
                        android:padding="4dp">

                        <View
                            android:id="@+id/auSegThumb"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:layout_gravity="start|center_vertical"
                            android:background="@drawable/bg_au_seg_thumb" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/auBtnFree"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="5"
                                android:background="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:minHeight="46dp"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="17dp"
                                    android:layout_height="17dp"
                                    android:src="@drawable/ic_bolt"
                                    android:tint="@color/au_accent_text" />

                                <TextView
                                    android:id="@+id/auFreeName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:fontFamily="@font/onest_600"
                                    android:text="@string/glass_free"
                                    android:textColor="@color/au_fg_2"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/auBtnPaid"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="7"
                                android:background="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:minHeight="46dp"
                                android:orientation="horizontal">

                                <com.naua_security_mirage.app.ui.view.AuroraFlagView
                                    android:id="@+id/auPaidFlagView"
                                    android:layout_width="20dp"
                                    android:layout_height="14dp"
                                    android:contentDescription="@null" />

                                <TextView
                                    android:id="@+id/auPaidName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:fontFamily="@font/onest_600"
                                    android:text="@string/plan_france"
                                    android:textColor="@color/au_fg_2"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/auTag"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:background="@drawable/bg_au_badge_rec"
                                    android:fontFamily="@font/onest_600"
                                    android:letterSpacing="0.04"
                                    android:paddingStart="7dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="7dp"
                                    android:paddingBottom="2dp"
                                    android:text="@string/au_tag_paid"
                                    android:textColor="@color/au_accent_text"
                                    android:textSize="11sp" />

                                <ImageView
                                    android:id="@+id/auPaidChevron"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_marginStart="2dp"
                                    android:src="@drawable/ic_arrow_down"
                                    android:tint="@color/au_fg_3" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/auCountryMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_au_menu"
                        android:elevation="8dp"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- speed card -->
                <LinearLayout
                    android:id="@+id/auSpeedCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_au_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:src="@drawable/ic_arrow_down"
                                    android:tint="@color/au_good" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/onest_600"
                                    android:letterSpacing="0.08"
                                    android:text="@string/glass_download"
                                    android:textAllCaps="true"
                                    android:textColor="@color/au_fg_2"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/auSpeedDown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/jetbrains_mono_500"
                                android:letterSpacing="-0.02"
                                android:text="10.0 KB/s"
                                android:textColor="@color/au_fg"
                                android:textSize="24sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:src="@drawable/ic_arrow_up"
                                    android:tint="@color/au_cool" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/onest_600"
                                    android:letterSpacing="0.08"
                                    android:text="@string/glass_upload"
                                    android:textAllCaps="true"
                                    android:textColor="@color/au_fg_2"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/auSpeedUp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/jetbrains_mono_500"
                                android:letterSpacing="-0.02"
                                android:text="7.0 KB/s"
                                android:textColor="@color/au_fg"
                                android:textSize="24sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.naua_security_mirage.app.ui.view.AuroraSparkView
                        android:id="@+id/auSpark"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

                <!-- donate link card -->
                <LinearLayout
                    android:id="@+id/auDonateCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_au_glass_link"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="68dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_au_tile">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_heart"
                            android:tint="@color/au_accent_text" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/onest_600"
                            android:text="@string/glass_donate_title"
                            android:textColor="@color/au_fg"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/onest_400"
                            android:text="@string/glass_donate_sub"
                            android:textColor="@color/au_fg_2"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/au_fg_3" />
                </LinearLayout>

                <!-- telegram link card -->
                <LinearLayout
                    android:id="@+id/auTelegramCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_au_glass_link"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="68dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_au_tile">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/au_send"
                            android:tint="@color/au_cool" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/onest_600"
                            android:text="@string/glass_telegram_title"
                            android:textColor="@color/au_fg"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/onest_400"
                            android:text="@string/au_tg_sub"
                            android:textColor="@color/au_fg_2"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/au_fg_3" />
                </LinearLayout>

                <!-- note -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_info"
                        android:tint="@color/au_accent_text" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/onest_400"
                        android:text="@string/au_note"
                        android:textColor="@color/au_fg_2"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <!-- dock -->
    <LinearLayout
        android:id="@+id/auDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:animateLayoutChanges="true"
        android:background="@drawable/bg_au_dock"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/auDockHome"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:animateLayoutChanges="true"
            android:background="@drawable/bg_au_tab_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/auDockHomeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/au_home"
                android:tint="@color/au_accent_text" />

            <TextView
                android:id="@+id/auDockHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/dock_home"
                android:textColor="@color/au_accent_text"
                android:textSize="14.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/auDockSettings"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:animateLayoutChanges="true"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/auDockSettingsIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_gear"
                android:tint="@color/au_fg_2" />

            <TextView
                android:id="@+id/auDockSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/dock_settings"
                android:textColor="@color/au_fg_2"
                android:textSize="14.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/auDockFaq"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:animateLayoutChanges="true"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/auDockFaqIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/au_help"
                android:tint="@color/au_fg_2" />

            <TextView
                android:id="@+id/auDockFaqLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/dock_faq"
                android:textColor="@color/au_fg_2"
                android:textSize="14.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/auDockVersion"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:animateLayoutChanges="true"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/auDockVersionIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_info"
                android:tint="@color/au_fg_2" />

            <TextView
                android:id="@+id/auDockVersionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/dock_version"
                android:textColor="@color/au_fg_2"
                android:textSize="14.5sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- overlay host -->
    <View
        android:id="@+id/auScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/au_scrim"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/auSheetContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_au_sheet"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="30dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/auToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="104dp"
        android:alpha="0"
        android:background="@drawable/bg_au_toast"
        android:ellipsize="end"
        android:fontFamily="@font/onest_600"
        android:gravity="center"
        android:maxWidth="340dp"
        android:maxLines="2"
        android:paddingStart="18dp"
        android:paddingTop="11dp"
        android:paddingEnd="18dp"
        android:paddingBottom="11dp"
        android:textColor="@color/au_fg"
        android:textSize="14sp" />
</FrameLayout>
