<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pillAiMode"
    android:layout_width="wrap_content"
    android:layout_height="46dp"
    android:background="@drawable/bg_pill"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingEnd="22dp">

    <ImageView
        android:id="@+id/ivAiModeIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/ai_mode"
        android:src="@drawable/ic_sparkle"
        app:tint="@color/accent" />

    <TextView
        android:id="@+id/tvAiMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/ai_mode"
        android:textColor="@color/ink"
        android:textSize="13.5sp"
        android:textStyle="bold"
        app:autoSizeTextType="uniform"
        app:autoSizeMaxTextSize="13.5sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeStepGranularity="1sp" />

    <View
        android:id="@+id/dotAiMode"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_dot_amber" />
</LinearLayout>
