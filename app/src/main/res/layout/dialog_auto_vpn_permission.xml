<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogAutoVpnRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivAutoVpnDialogIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_info" />

        <TextView
            android:id="@+id/tvAutoVpnDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/auto_vpn_dialog_title"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAutoVpnDialogBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/auto_vpn_dialog_msg"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvAutoVpnDialogSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?attr/mirageCardBg"
        android:lineSpacingExtra="4dp"
        android:padding="14dp"
        android:text="@string/auto_vpn_dialog_steps"
        android:textColor="@color/amber"
        android:textSize="12.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnAutoVpnStepAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/auto_vpn_step_app_info"
            android:textColor="@color/ink"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAutoVpnStepUsageAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/auto_vpn_step_usage_access"
            android:textColor="@color/amber"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAutoVpnDialogClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/auto_vpn_dialog_close"
            android:textColor="@color/ink_soft"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
