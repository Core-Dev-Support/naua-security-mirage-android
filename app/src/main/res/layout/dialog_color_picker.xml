<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogColorPickerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvPickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Выбор цвета"
        android:textColor="@color/ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Color Preview & HEX Input Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <View
            android:id="@+id/vColorPreview"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHexLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HEX код"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etHexCode"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="7"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hue Slider -->
    <TextView
        android:id="@+id/tvHueLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Оттенок"
        android:textColor="@color/ink_soft"
        android:textSize="12.5sp" />

    <SeekBar
        android:id="@+id/sbHue"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:max="360"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:splitTrack="false" />

    <!-- Saturation Slider -->
    <TextView
        android:id="@+id/tvSatLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Насыщенность"
        android:textColor="@color/ink_soft"
        android:textSize="12.5sp" />

    <SeekBar
        android:id="@+id/sbSat"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:splitTrack="false" />

    <!-- Brightness Slider -->
    <TextView
        android:id="@+id/tvValLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Яркость"
        android:textColor="@color/ink_soft"
        android:textSize="12.5sp" />

    <SeekBar
        android:id="@+id/sbVal"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:splitTrack="false" />

    <!-- Quick Preset Colors -->
    <TextView
        android:id="@+id/tvQuickLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Быстрые цвета"
        android:textColor="@color/ink_soft"
        android:textSize="12.5sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/containerQuickColors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Dialog Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPickerCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="Отмена"
            android:textColor="@color/ink_soft"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPickerApply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="22dp"
            android:paddingTop="10dp"
            android:paddingEnd="22dp"
            android:paddingBottom="10dp"
            android:text="Применить"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
