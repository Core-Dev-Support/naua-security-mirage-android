<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="#1C2130">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_sparkle"
                app:tint="#E8A33D" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_premium_title"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/sub_premium_desc"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSubCancel"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            app:tint="@color/ink_muted" />
    </LinearLayout>

    <View
        android:id="@+id/dividerSubHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="@color/card_stroke" />

    <!-- Price Card -->
    <LinearLayout
        android:id="@+id/priceCardBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_plan_30days"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_price_from"
                android:textColor="#E8A33D"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:backgroundTint="#2A241C"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/sub_hit_badge"
            android:textColor="#E8A33D"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Features -->
    <TextView
        android:id="@+id/tvSubFeatures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="4dp"
        android:text="@string/sub_features"
        android:textColor="@color/ink_soft"
        android:textSize="12.5sp" />

    <!-- Pay Button -->
    <Button
        android:id="@+id/btnSubPay"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#E8A33D"
        android:text="@string/sub_pay_button"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

    <!-- Check Status Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubCheck"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/card"
        android:text="@string/sub_check_payment"
        android:textAllCaps="false"
        android:textColor="@color/ink"
        android:textSize="13sp"
        app:cornerRadius="14dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp" />

    <!-- One free day of the paid node -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubTrial"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/card"
        android:text="@string/sub_trial_button"
        android:textAllCaps="false"
        android:textColor="#E8A33D"
        android:textSize="13sp"
        android:visibility="gone"
        app:cornerRadius="14dp"
        app:strokeColor="#E8A33D"
        app:strokeWidth="1dp" />

    <TextView
        android:id="@+id/tvSubTrialDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/sub_trial_desc"
        android:textColor="@color/ink_soft"
        android:textSize="11.5sp"
        android:visibility="gone" />

</LinearLayout>
