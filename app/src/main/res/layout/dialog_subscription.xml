<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="#1C2130">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_sparkle"
                app:tint="#E8A33D" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Премиум Франция 🇫🇷"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Выделенный сервер без ограничений"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSubCancel"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            app:tint="@color/ink_muted" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="@color/card_stroke" />

    <!-- Price Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 дней доступа"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 ₽"
                android:textColor="#E8A33D"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:backgroundTint="#2A241C"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="ХИТ"
            android:textColor="#E8A33D"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Features -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="4dp"
        android:text="• Выделенный сервер во Франции (Париж)\n• Максимальная скорость до 1 Гбит/с без лимитов\n• Протокол Reality против любых блокировок\n• Моментальная онлайн-активация"
        android:textColor="@color/ink_soft"
        android:textSize="12.5sp" />

    <!-- Pay Button -->
    <Button
        android:id="@+id/btnSubPay"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#E8A33D"
        android:text="Оплатить через ЮMoney (30 ₽)"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

    <!-- Check Status Button -->
    <Button
        android:id="@+id/btnSubCheck"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/card"
        android:text="Проверить оплату"
        android:textAllCaps="false"
        android:textColor="@color/ink"
        android:textSize="13sp"
        app:cornerRadius="14dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp" />

</LinearLayout>
