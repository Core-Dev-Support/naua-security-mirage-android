<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/mirageCardBg"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvUiStyleDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ui_style_dialog_title"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCloseUiStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="@string/ui_style_close"
            android:textColor="@color/ink_soft"
            android:textSize="26sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ui_style_dialog_subtitle"
        android:textColor="@color/ink_soft"
        android:textSize="12.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cardStyleClassic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ui_style_option"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="8dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@drawable/bg_preview_phone"
                android:padding="10dp">

                <View
                    android:layout_width="52dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_preview_row_old" />

                <View
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_preview_orb_old" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="13dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/bg_preview_row_old" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="13dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/bg_preview_row_old" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="13dp"
                        android:background="@drawable/bg_preview_row_old" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvStyleClassicLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/ui_style_classic"
                android:textColor="@color/ink"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/ui_style_classic_desc"
                android:textColor="@color/ink_soft"
                android:textSize="11.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardStyleGlass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ui_style_option"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="8dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@drawable/bg_preview_phone"
                android:padding="10dp">

                <View
                    android:layout_width="52dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_preview_row_glass" />

                <View
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_preview_orb_glass" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="13dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/bg_preview_row_glass" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="13dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/bg_preview_row_glass" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="13dp"
                        android:background="@drawable/bg_preview_row_glass" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvStyleGlassLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/ui_style_glass"
                android:textColor="@color/ink"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/ui_style_glass_desc"
                android:textColor="@color/ink_soft"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
