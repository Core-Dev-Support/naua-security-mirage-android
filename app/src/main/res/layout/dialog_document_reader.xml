<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogReaderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_card">

    <!-- Telegraph Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Документ"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReaderMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Core Dev Support • 17 сентября 2026 г."
                android:textColor="@color/ink_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivReaderClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:tint="@color/ink_muted"
            android:contentDescription="Закрыть" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/vReaderDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke"
        android:layout_marginBottom="12dp" />

    <!-- Document Content in Telegraph reading style -->
    <ScrollView
        android:id="@+id/svReaderContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadingEdgeLength="20dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvReaderContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textIsSelectable="true" />

            <!-- Author & Contact Card -->
            <LinearLayout
                android:id="@+id/cardReaderAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvReaderAuthorLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="РАЗРАБОТЧИК И КОНТАКТЫ"
                    android:textColor="@color/ink_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReaderAuthorName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Разработчик: Core Dev Support"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReaderAuthorEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Email: coredevsupport@gmail.com"
                    android:textColor="@color/amber"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvReaderWebLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Открыть оригинал документа в Google Docs ↗"
                    android:textColor="@color/amber"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Done Button -->
    <TextView
        android:id="@+id/btnReaderDone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:text="Понятно"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
