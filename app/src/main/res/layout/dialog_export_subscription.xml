<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/mirageCardBg"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/miragePillBg"
            android:backgroundTint="#1C2130">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_qrcode"
                app:tint="#E8A33D" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvExportTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_dialog_title"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExportSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/export_dialog_subtitle"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnExportClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            app:tint="@color/ink_muted" />
    </LinearLayout>

    <View
        android:id="@+id/dividerExportHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="@color/card_stroke" />

    <!-- Node Selector Chips Container (Horizontal Scroll) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/containerExportChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- QR Code Container -->
    <FrameLayout
        android:id="@+id/cardQrContainer"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pill_active"
        android:backgroundTint="#FFFFFF"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivExportQr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/export_qr_content_desc"
            android:scaleType="fitCenter" />

        <ProgressBar
            android:id="@+id/pbExportLoading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Key Info Label -->
    <TextView
        android:id="@+id/tvExportKeyInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/export_key_hint"
        android:textColor="@color/ink_soft"
        android:textSize="12sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:backgroundTint="#E8A33D"
            android:paddingHorizontal="14dp"
            android:text="@string/action_copy_link"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportShare"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="14dp"
            android:text="@string/action_share_key"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="13.5sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Multi-device info hint -->
    <TextView
        android:id="@+id/tvExportHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/export_multi_device_info"
        android:textColor="@color/ink_faint"
        android:textSize="11sp" />

</LinearLayout>
