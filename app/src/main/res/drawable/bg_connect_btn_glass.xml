<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="96dp"
                android:centerX="0.35"
                android:centerY="0.28"
                android:startColor="#40FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#00101014" />
        </shape>
    </item>
    <item
        android:left="9dp"
        android:top="9dp"
        android:right="9dp"
        android:bottom="9dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="84dp"
                android:centerX="0.36"
                android:centerY="0.28"
                android:startColor="#FFE094"
                android:centerColor="#F0A53B"
                android:endColor="#9C5B11" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
