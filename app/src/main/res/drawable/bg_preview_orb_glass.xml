<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="24dp"
                android:centerX="0.35"
                android:centerY="0.28"
                android:startColor="#40FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#00101014" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="18dp"
                android:centerX="0.36"
                android:centerY="0.28"
                android:startColor="#FFE094"
                android:centerColor="#F0A53B"
                android:endColor="#9C5B11" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
