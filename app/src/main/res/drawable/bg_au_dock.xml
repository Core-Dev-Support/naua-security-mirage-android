<?xml version="1.0" encoding="utf-8"?>
<!-- dock: 36dp glass, stronger top highlight -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <gradient
                android:type="linear" android:angle="225"
                android:startColor="#2EFFFFFF" android:endColor="#0DFFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <gradient
                android:type="linear" android:angle="90"
                android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
